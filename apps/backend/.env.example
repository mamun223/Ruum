# Tennis API Key (get free key at https://tennis-api.com)
TENNIS_API_KEY=your_api_key_here

# Database URL (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server Port
PORT=3000

# Scheduled refresh (ingest + re-predict). Set ENABLE_SCHEDULER=false to disable
ENABLE_SCHEDULER=true
REFRESH_INTERVAL_MINUTES=15

# AI name-meaning suggestions (set ONE key; suggestions are saved unapproved)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: force provider (anthropic|openai) and model
AI_PROVIDER=
AI_MODEL=
